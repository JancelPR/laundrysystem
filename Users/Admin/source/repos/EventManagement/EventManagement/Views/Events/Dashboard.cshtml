@model IEnumerable<EventManagement.Models.Events>

<div class="container mt-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-5" style="color: #1B4242;">Event Management Dashboard</h1>
        <p class="text-muted">Track your events, view key metrics, and manage everything in one place.</p>
    </div>

    <!-- Metrics Section -->
    <div class="row text-center mb-5">
        <div class="col-md-3">
            <div class="card shadow-sm" style="background-color: #3B6D5B; color: #FFFFFF;">
                <div class="card-body">
                    <i class="fas fa-calendar-alt fa-3x mb-3"></i>
                    <h5 class="card-title">Total Events</h5>
                    <p class="display-6 fw-bold">@Model.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm" style="background-color: #4C6A4F; color: #FFFFFF;">
                <div class="card-body">
                    <i class="fas fa-calendar-check fa-3x mb-3"></i>
                    <h5 class="card-title">Upcoming Events</h5>
                    <p class="display-6 fw-bold">@Model.Count(e => e.Date >= DateTime.Now)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm" style="background-color: #2E3B3A; color: #FFFFFF;">
                <div class="card-body">
                    <i class="fas fa-calendar-times fa-3x mb-3"></i>
                    <h5 class="card-title">Past Events</h5>
                    <p class="display-6 fw-bold">@Model.Count(e => e.Date < DateTime.Now)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm" style="background-color: #A9C4A3; color: #1B4242;">
                <div class="card-body">
                    <i class="fas fa-users fa-3x mb-3"></i>
                    <h5 class="card-title">Total Attendees</h5>
                    <p class="display-6 fw-bold">@Model.Sum(e => int.Parse(e.AttendeeCount))</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Section -->
    <div class="row justify-content-center mb-5" style="background-color: #F1F8F5; padding: 20px; border-radius: 10px;">
        <div class="col-md-4 mb-3">
            <!-- Create New Event Button -->
            <a href="/Events/Create" class="btn btn-event-primary w-100">
                <i class="fas fa-plus-circle"></i> Create Event
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <!-- View Monthly Report Button -->
            <a href="/Events/MonthlyReport" class="btn btn-report-primary w-100">
                <i class="fas fa-chart-line"></i> Monthly Report
            </a>
        </div>
    </div>

    <!-- Add this to your existing CSS -->
    <style>
        .btn-event-primary {
            background: linear-gradient(135deg, #3B6D5B, #4C6A4F); /* Soft gradient from green to darker green */
            color: white;
            font-weight: bold;
            border-radius: 30px; /* Rounded corners for a soft look */
            padding: 15px 25px;
            text-transform: uppercase;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease-in-out;
        }

            .btn-event-primary:hover {
                background: linear-gradient(135deg, #4C6A4F, #3B6D5B); /* Reversed gradient on hover */
                transform: translateY(-3px); /* Lift effect on hover */
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            }

        .btn-report-primary {
            background: linear-gradient(135deg, #2E3B3A, #A9C4A3); /* Elegant gradient from dark green to light green */
            color: white;
            font-weight: bold;
            border-radius: 30px; /* Rounded corners for a soft look */
            padding: 15px 25px;
            text-transform: uppercase;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease-in-out;
        }

            .btn-report-primary:hover {
                background: linear-gradient(135deg, #A9C4A3, #2E3B3A); /* Reversed gradient on hover */
                transform: translateY(-3px); /* Lift effect on hover */
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            }
    </style>

    <!-- Add this to your existing CSS -->
    <style>
        .btn-event-primary {
            background: linear-gradient(135deg, #ff7e5f, #feb47b); /* Soft gradient from coral to peach */
            color: white;
            font-weight: bold;
            border-radius: 30px; /* Rounded corners for a soft look */
            padding: 15px 25px;
            text-transform: uppercase;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease-in-out;
        }

            .btn-event-primary:hover {
                background: linear-gradient(135deg, #feb47b, #ff7e5f); /* Reversed gradient on hover */
                transform: translateY(-3px); /* Lift effect on hover */
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            }

        .btn-report-primary {
            background: linear-gradient(135deg, #6a11cb, #2575fc); /* Elegant gradient from purple to blue */
            color: white;
            font-weight: bold;
            border-radius: 30px; /* Rounded corners for a soft look */
            padding: 15px 25px;
            text-transform: uppercase;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease-in-out;
        }

            .btn-report-primary:hover {
                background: linear-gradient(135deg, #2575fc, #6a11cb); /* Reversed gradient on hover */
                transform: translateY(-3px); /* Lift effect on hover */
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            }
    </style>


    <!-- Events Table Section -->
    <div class="card shadow-sm">
        <div class="card-header" style="background-color: #2E3B3A; color: #FFFFFF;">
            <h5 class="mb-0"><i class="fas fa-list"></i> Your Events</h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped table-hover">
                <thead style="background-color: #4C6A4F; color: #FFFFFF;">
                    <tr>
                        <th>#</th>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Attendee Count</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int index = 1;
                        foreach (var eventItem in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@eventItem.EventName</td>
                                <td>@eventItem.Description</td>
                                <td>@eventItem.Date.ToString("yyyy-MM-dd")</td>
                                <td>@eventItem.Location</td>
                                <td>@eventItem.Category</td>
                                <td>@eventItem.AttendeeCount</td>
                                <td>
                                    @if (eventItem.Date >= DateTime.Now)
                                    {
                                        <span class="badge" style="background-color: #3B6D5B; color: #FFFFFF;">Upcoming</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background-color: #2E3B3A; color: #FFFFFF;">Completed</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/Events/Details/@eventItem.Id" class="btn btn-sm" style="background-color: #4C6A4F; color: #FFFFFF;">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/Events/Edit/@eventItem.Id" class="btn btn-sm" style="background-color: #A9C4A3; color: #1B4242;">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm deleteEventButton" style="background-color: #BE3144; color: #FFFFFF;" data-id="@eventItem.Id">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted">No events found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="id" id="deleteEventId" />
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script>
        document.querySelectorAll(".deleteEventButton").forEach(button => {
            button.addEventListener("click", function () {
                const eventId = this.getAttribute("data-id");
                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Set the event ID in the hidden form and submit it
                        document.getElementById("deleteEventId").value = eventId;
                        document.getElementById("deleteForm").submit();
                    }
                });
            });
        });
    </script>
}
