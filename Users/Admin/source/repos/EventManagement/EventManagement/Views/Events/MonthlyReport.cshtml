@model IEnumerable<EventManagement.Models.MonthlyReportView>

@{
    ViewData["Title"] = "Monthly Report";
}
<a class="btn btn-primary mb-4" href="Dashboard" title="Index">Back to Dashboard</a>

<div class="table-responsive">
    <h2 class="mb-4">Monthly Event Report</h2>
    <table class="table table-striped table-hover align-middle" id="eventsTable">
        <thead>
            <tr style="background: linear-gradient(to right, #8e2de2, #ff6ec4); color: white;">
                <th>Month</th>
                <th>Total Events</th>
                <th>Total Attendees</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                <tr class="clickable-row" style="cursor:pointer;" data-year="@report.Year" data-month="@report.Month">
                    <td>@report.MonthName</td>
                    <td>@report.EventCount</td>
                    <td>@report.TotalAttendees</td>
                    <td>
                        <a href="/Events/MonthlyDetails?year=@report.Year&month=@report.Month" class="ms-2" onclick="event.stopPropagation();">
                            <i class="fa-solid fa-circle-info"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const rows = document.querySelectorAll(".clickable-row");
            rows.forEach(row => {
                row.addEventListener("click", function () {
                    const year = this.dataset.year;
                    const month = this.dataset.month;
                    window.location.href = /Events/MonthlyDetails?year=${year}&month=${month};
                });
            });
        });
    </script>
}