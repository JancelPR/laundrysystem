@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-3 fw-bold text-primary mb-4">Welcome to Event Manager</h1>
    <p class="lead text-muted mb-4">The easiest way to plan, manage, and execute your events with precision and ease.</p>
    <a href="#features" class="btn btn-lg btn-outline-primary rounded-pill shadow-lg">Discover More</a>
</div>

<!-- New Section: Features of the Event Management System -->
<div id="features" class="bg-light py-5">
    <div class="container">
        <h2 class="text-center display-4 fw-bold mb-5">Key Features</h2>
        <div class="row justify-content-center">
            <!-- Feature 1 -->
            <div class="col-lg-4 col-md-6 mb-5">
                <div class="card shadow-lg border-light rounded h-100">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-calendar-event fs-1 text-primary mb-3"></i>
                        <h5 class="card-title mb-3">Event Scheduling</h5>
                        <p class="card-text">Easily schedule and track all your events in one place. Manage dates, venues, and attendees seamlessly.</p>
                    </div>
                </div>
            </div>
            <!-- Feature 2 -->
            <div class="col-lg-4 col-md-6 mb-5">
                <div class="card shadow-lg border-light rounded h-100">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-person-check fs-1 text-primary mb-3"></i>
                        <h5 class="card-title mb-3">Attendee Management</h5>
                        <p class="card-text">Manage guest lists, track RSVPs, and communicate with attendees through our built-in tools.</p>
                    </div>
                </div>
            </div>
            <!-- Feature 3 -->
            <div class="col-lg-4 col-md-6 mb-5">
                <div class="card shadow-lg border-light rounded h-100">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-bar-chart-line fs-1 text-primary mb-3"></i>
                        <h5 class="card-title mb-3">Event Analytics</h5>
                        <p class="card-text">Track event performance with detailed analytics, from attendee numbers to engagement rates.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
